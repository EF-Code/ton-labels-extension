{
  "manifest_version": 3,
  "name": "TON Address Labels",
  "version": "2.0.0",
  "description": "Displays verified-format labels for TON blockchain addresses on TON Viewer",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://cdn.jsdelivr.net/*",
    "https://tonviewer.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tonviewer.com/*"
      ],
      "js": [
        "address-utils.js",
        "label-database.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
